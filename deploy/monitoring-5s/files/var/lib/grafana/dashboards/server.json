    {
      "id": 12,
      "title": "Tous les capteurs matériels (hwmon)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 68,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-local"
      },
      "targets": [
        {
