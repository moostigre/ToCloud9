    },
    {
      "id": 17,
      "title": "Débit réseau entrant",
      "description": "Débit par interface, vu depuis le serveur. Les interfaces physiques, bridges et interfaces des VM peuvent observer le même trafic ; leurs valeurs ne sont pas additionnées.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-local"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(8 * rate(node_network_receive_bytes_total{instance=~\"$instance\",device=~\"$device\",device!=\"lo\"}[$__rate_interval])) * on(job,instance) group_left(nodename) max by(job,instance,nodename) (node_uname_info{job=\"quanta-hosts\"})",
          "legendFormat": "{{nodename}} · {{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 18,
