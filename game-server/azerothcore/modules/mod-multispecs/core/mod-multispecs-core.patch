diff --git a/src/server/game/Handlers/SkillHandler.cpp b/src/server/game/Handlers/SkillHandler.cpp
index e07ab93d2..57a4c1540 100644
--- a/src/server/game/Handlers/SkillHandler.cpp
+++ b/src/server/game/Handlers/SkillHandler.cpp
@@ -15,6 +15,7 @@
  */

+#include "DBCStores.h"
 #include "Log.h"
 #include "Opcodes.h"
 #include "Player.h"
 #include "SpellMgr.h"
@@ -27,6 +28,22 @@ void WorldSession::HandleLearnTalentOpcode(WorldPacket& recvData)
     uint32 talent_id, requested_rank;
     recvData >> talent_id >> requested_rank;

+    // The 3.3.5a client only owns two talent-group buffers. For extended
+    // server slots, retain its native CMSG_LEARN_TALENT packet but derive the
+    // requested next rank from the active server group instead of the aliased
+    // client group.
+    if (_player->GetActiveSpec() >= 2)
+    {
+        requested_rank = 0;
+        if (TalentEntry const* talent = sTalentStore.LookupEntry(talent_id))
+            for (uint8 rank = 0; rank < MAX_TALENT_RANK; ++rank)
+                if (talent->RankID[rank] && _player->HasTalent(talent->RankID[rank], _player->GetActiveSpec()))
+                {
+                    requested_rank = rank + 1;
+                    break;
+                }
+    }
+
     _player->LearnTalent(talent_id, requested_rank);
     _player->SendTalentsInfoData(false);
 }
diff --git a/src/server/game/Entities/Player/Player.cpp b/src/server/game/Entities/Player/Player.cpp
index 5419ae0cd..c7a3c1000 100644
--- a/src/server/game/Entities/Player/Player.cpp
+++ b/src/server/game/Entities/Player/Player.cpp
@@ -3873,8 +3873,20 @@ bool Player::resetTalents(bool noResetCost)
     // xinef: get max available talent points amount
     uint32 talentPointsForLevel = CalculateTalentsPoints();

-    // xinef: no talent points are used, return
-    if (m_usedTalentCount == 0)
+    // Extended talent groups are not represented reliably by the stock
+    // two-group used-point cache. Inspect the authoritative active talent mask
+    // before deciding that there is nothing to reset.
+    bool hasActiveTalents = false;
+    for (auto const& [spellId, talent] : m_talents)
+    {
+        (void)spellId;
+        if (talent->State != PLAYERSPELL_REMOVED && (talent->specMask & GetActiveSpecMask()))
+        {
+            hasActiveTalents = true;
+            break;
+        }
+    }
+    if (m_usedTalentCount == 0 && !hasActiveTalents)
         return false;
     m_usedTalentCount = 0;

