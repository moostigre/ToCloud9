diff --git a/src/server/game/Handlers/MovementHandler.cpp b/src/server/game/Handlers/MovementHandler.cpp
index 76bbb321b..ccb916ecf 100644
--- a/src/server/game/Handlers/MovementHandler.cpp
+++ b/src/server/game/Handlers/MovementHandler.cpp
@@ -81,8 +81,14 @@ void WorldSession::HandleMoveWorldportAckOpcode()
     if (!GetPlayer()->m_InstanceValid && !mInstance)
     {
         GetPlayer()->m_InstanceValid = true;
-        // pussywizard: m_InstanceValid can be false only by leaving a group in an instance => so remove temp binds that could not be removed because player was still on the map!
-        if (!sInstanceSaveMgr->PlayerIsPermBoundToInstance(GetPlayer()->GetGUID(), oldMap->GetId(), oldMap->GetDifficulty()))
+        // A TC9 redirect reconstructs group state asynchronously on another
+        // worldserver. During that handoff m_InstanceValid can temporarily be
+        // false even though the player did not leave or reset the group. Keep
+        // the temporary bind in cluster mode so returning to the dungeon
+        // resolves the existing instance instead of consuming a new hourly
+        // instance slot.
+        if (!sToCloud9Sidecar->ClusterModeEnabled() &&
+            !sInstanceSaveMgr->PlayerIsPermBoundToInstance(GetPlayer()->GetGUID(), oldMap->GetId(), oldMap->GetDifficulty()))
             sInstanceSaveMgr->PlayerUnbindInstance(GetPlayer()->GetGUID(), oldMap->GetId(), oldMap->GetDifficulty(), true);
     }
 
