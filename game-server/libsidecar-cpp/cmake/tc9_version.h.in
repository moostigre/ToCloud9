#ifndef TC9_VERSION_H
#define TC9_VERSION_H

/* Generated from the CMake project version. */
#define TC9_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define TC9_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define TC9_VERSION_PATCH @PROJECT_VERSION_PATCH@

#define TC9_VERSION_STRING "@PROJECT_VERSION@"
#define TC9_VERSION_NUMBER \
    (TC9_VERSION_MAJOR * 10000 + TC9_VERSION_MINOR * 100 + TC9_VERSION_PATCH)

#endif /* TC9_VERSION_H */

